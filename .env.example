# Resend — formularz kontaktowy i mail po płatności
RESEND_API_KEY=
RESEND_FROM="Dmuchańce <onboarding@resend.dev>"
ORDER_NOTIFY_EMAIL=
CONTACT_TO_EMAIL=

# Publiczny adres strony. Na Vercelu możesz zostawić puste:
# serwer weźmie adres z żądania.
SITE_URL=

# Przelewy24 sandbox. Produkcja: P24_SANDBOX=false
P24_SANDBOX=true
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=

# Na Vercelu powstaje samo po dodaniu Blob Storage.
BLOB_READ_WRITE_TOKEN=

# Supabase — pamięć rezerwacji. Klucz service role zostaje tylko na serwerze.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hasło do strony /rezerwacje
REZERWACJE_HASLO=
